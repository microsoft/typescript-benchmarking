{
    "compilerOptions": {
        "strictNullChecks": false,
        "strictFunctionTypes": false,
        "lib": ["es2015"],
        "noEmitOnError": false,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "alwaysStrict": true,
        "pretty": true,
        "preserveConstEnums": true,
        "stripInternal": true,
        "sourceMap": true,
        "target": "es2015",
        "newLine": "lf",
        "skipLibCheck": true,
        "types": []
    }
}
